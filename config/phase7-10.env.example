# Optional Phase 7.10 settings for .env.production

# Seconds between automatic MongoDB backups. Default: 86400 (24 hours).
MONGO_BACKUP_INTERVAL_SECONDS=86400

# Delete backup families older than this many days, while preserving the
# minimum count below. Default: 14.
MONGO_BACKUP_RETENTION_DAYS=14

# Always retain at least this many backup families. Default: 3.
MONGO_BACKUP_MIN_COUNT=3

