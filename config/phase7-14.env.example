# SalonAI Phase 7.14 production deployment environment
# Copy to an untracked .env.production file on the production host.
# The GitHub deployment workflow derives APP_VERSION, RELEASE_SOURCE_COMMIT and
# the three immutable image references from release-manifest.json.

APP_VERSION=v7.14.0
RELEASE_SOURCE_COMMIT=<40-character-release-commit>
AI_SERVICE_IMAGE=ghcr.io/francescoguerriero/salonai-ai-service@sha256:<64-character-digest>
BACKEND_IMAGE=ghcr.io/francescoguerriero/salonai-backend@sha256:<64-character-digest>
FRONTEND_IMAGE=ghcr.io/francescoguerriero/salonai-frontend@sha256:<64-character-digest>

SALONAI_DOMAIN=salon.example.com
PUBLIC_BASE_URL=https://salon.example.com
FRONTEND_URL=https://salon.example.com

MONGO_ROOT_USERNAME=salonai
MONGO_ROOT_PASSWORD=CHANGE_ME_USE_A_RANDOM_PASSWORD_AT_LEAST_24_CHARACTERS
MONGO_DATABASE=salonai
JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_64_RANDOM_CHARACTERS

TLS_CERT_DIR=./deployment/tls
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
ALERTMANAGER_PORT=9093
BLACKBOX_PORT=9115
LOKI_PORT=3100
TEMPO_PORT=3200
ALLOY_PORT=12345
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_USE_A_RANDOM_PASSWORD_AT_LEAST_24_CHARACTERS

BACKEND_LOG_LEVEL=info
SERVER_SHUTDOWN_TIMEOUT_MS=30000
METRICS_ENABLED=true
TRACING_ENABLED=true
TRACE_EXPORT_TIMEOUT_MS=5000
OTEL_TRACES_SAMPLER_ARG=0.1

VITE_API_URL=/api
VITE_AI_API_URL=/ai
