# syntax=docker/dockerfile:1

FROM docker.io/library/python:3.13-slim-trixie@sha256:ffb752e139c0a19692a43af8d8523b274222dd68eebad5d583b45c2201c6e30a AS dependencies

WORKDIR /build

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

# Distroless Python is located at /usr/bin/python.
# Build the virtual environment against that interpreter path so
# the copied virtual environment remains valid in the runtime stage.
RUN ln -sf /usr/local/bin/python /usr/bin/python \
    && /usr/bin/python -m venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.runtime.txt ./

RUN python -m pip install --upgrade pip setuptools==83.0.0 wheel \
    && python -m pip install --no-cache-dir -r requirements.runtime.txt


FROM dependencies AS test

WORKDIR /workspace

COPY requirements.txt requirements.runtime.txt pyproject.toml ./
COPY app ./app
COPY tests ./tests

RUN python -m pip install --no-cache-dir -r requirements.txt \
    && python -m pytest


FROM dependencies AS runtime-dependencies

RUN python -m pip uninstall -y pip setuptools wheel \
    && find /opt/venv -type d -name '__pycache__' -prune -exec rm -rf '{}' + \
    && find /opt/venv -type f -name '*.pyc' -delete \
    && mkdir -p /runtime/model-cache \
    && printf 'SalonAI model-cache volume initialization\n' \
       > /runtime/model-cache/.salonai-volume-seed \
    && chown -R 10002:10002 /runtime/model-cache


FROM gcr.io/distroless/python3-debian13:nonroot@sha256:f3d5ddc6c64a019fe520e7f005f2880be21e6afc461b10a3c15ef2e4edc71e33 AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH="/app" \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

COPY --from=runtime-dependencies --chown=10002:10002 /opt/venv /opt/venv

# Seed the production model-cache mount point with the same numeric
# ownership as the non-root runtime user. Docker copies this content
# into a newly created empty named volume on first mount.
COPY --from=runtime-dependencies --chown=10002:10002 /runtime/model-cache /app/model-cache

COPY --chown=10002:10002 app ./app
COPY --chown=10002:10002 requirements.runtime.txt pyproject.toml ./

USER 10002:10002

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["/opt/venv/bin/python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4)"]

ENTRYPOINT ["/opt/venv/bin/python"]

CMD ["-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers"]
