# syntax=docker/dockerfile:1
FROM docker.io/library/python@sha256:4fad23465a06cc5149a541fbec6f87e234a64dc0550f6bfdd2d290d8f03240df AS dependencies

WORKDIR /build

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN python -m venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.runtime.txt ./

RUN python -m pip install --upgrade pip setuptools==83.0.0 wheel \
    && python -m pip install --no-cache-dir -r requirements.runtime.txt

FROM dependencies AS test

WORKDIR /workspace

COPY requirements.txt requirements.runtime.txt pyproject.toml ./
COPY app ./app
COPY tests ./tests

RUN python -m pip install --no-cache-dir -r requirements.txt \
    && python -m pytest

FROM dependencies AS runtime-dependencies

RUN python -m pip uninstall -y pip setuptools wheel \
    && find /opt/venv -type d -name '__pycache__' -prune -exec rm -rf '{}' + \
    && find /opt/venv -type f -name '*.pyc' -delete

FROM docker.io/library/python@sha256:4fad23465a06cc5149a541fbec6f87e234a64dc0550f6bfdd2d290d8f03240df AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH="/app" \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

RUN groupadd --gid 10002 salonai \
    && useradd \
        --uid 10002 \
        --gid 10002 \
        --no-create-home \
        --home-dir /nonexistent \
        --shell /usr/sbin/nologin \
        salonai \
    && rm -rf /usr/local/lib/python*/site-packages/pip* /usr/local/bin/pip*

COPY --from=runtime-dependencies --chown=10002:10002 /opt/venv /opt/venv
COPY --chown=10002:10002 app ./app
COPY --chown=10002:10002 requirements.runtime.txt pyproject.toml ./

USER 10002

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["/opt/venv/bin/python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4)"]

ENTRYPOINT ["/opt/venv/bin/python"]
CMD ["-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers"]
