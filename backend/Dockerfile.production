FROM node:26-alpine AS dependencies
WORKDIR /app

COPY package.json package-lock.json ./

RUN npm ci --omit=dev --ignore-scripts \
    && find node_modules -type f \
        \( -name 'Dockerfile' \
        -o -name 'Dockerfile.*' \
        -o -name '*.Dockerfile' \
        -o -name '*.dockerfile' \) \
        -exec rm -f {} + \
    && npm cache clean --force

FROM node:26.7.0-alpine3.24 AS runtime
# SALONAI_PHASE_7_17_BACKEND_IMAGE_REMEDIATION=1
RUN apk upgrade --no-cache

ENV NODE_ENV=production
WORKDIR /app

RUN addgroup -S -g 10001 salonai \
    && adduser -S -D -H -u 10001 -G salonai salonai

COPY --from=dependencies --chown=salonai:salonai /app/node_modules ./node_modules
COPY --chown=salonai:salonai package.json package-lock.json server.js ./
COPY --chown=salonai:salonai src ./src
COPY --chown=salonai:salonai scripts ./scripts

# npm is required during dependency installation, but not by the running API.
RUN rm -rf /usr/local/lib/node_modules/npm \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx

USER salonai

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
    CMD wget -qO- http://127.0.0.1:5000/api/health || exit 1

CMD ["node", "server.js"]
