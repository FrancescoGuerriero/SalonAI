FROM node:22-alpine AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

FROM node:22.23.1-alpine3.24 AS runtime
# SALONAI_PHASE_7_11_BACKEND_RUNTIME_HARDENING=2
RUN apk upgrade --no-cache
ENV NODE_ENV=production
WORKDIR /app

RUN addgroup -S -g 10001 salonai     && adduser -S -D -H -u 10001 -G salonai salonai

COPY --from=dependencies --chown=salonai:salonai /app/node_modules ./node_modules
COPY --chown=salonai:salonai package.json package-lock.json server.js ./
COPY --chown=salonai:salonai src ./src
COPY --chown=salonai:salonai scripts ./scripts

# npm is required during build, but not by the running API.
RUN rm -rf /usr/local/lib/node_modules/npm && rm -f /usr/local/bin/npm /usr/local/bin/npx
USER salonai
EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3   CMD wget -qO- http://127.0.0.1:5000/api/health || exit 1

CMD ["node", "server.js"]
