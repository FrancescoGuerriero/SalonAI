# SalonAI backend environment example
# Copy to .env for local development or .env.production for production.
# Never commit populated secret files.

NODE_ENV=development
HOST=0.0.0.0
PORT=5000
APPLICATION_NAME=SalonAI
FRONTEND_URL=http://localhost:5173
APPLICATION_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000/api
BOOKING_URL=http://localhost:5173/booking
SERVER_SHUTDOWN_TIMEOUT_MS=30000
LOG_LEVEL=info

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=<generate-at-least-64-random-bytes>
JWT_REFRESH_SECRET=<generate-a-different-at-least-64-random-bytes>
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PASSWORD_RESET_MINUTES=20

# Production is behind the trusted SalonAI nginx edge container.
TRUST_PROXY=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30

SALON_NAME=SalonAI
SALON_EMAIL=info@francescopicardi.co.uk
SALON_PHONE=+440000000000
SALON_ADDRESS=London, UK
SALON_TIME_ZONE=Europe/London

AI_SERVICE_URL=http://localhost:8000
AI_PROVIDER_MODE=mock
AI_PROVIDER=mock
AI_ENDPOINT=
AI_MODEL=
AI_API_KEY=

# Stripe payments
# Local development may use console. Production payment acceptance should use stripe.
# Production refuses to start with sk_test_... when PAYMENT_PROVIDER_MODE=stripe.
PAYMENT_PROVIDER_MODE=console
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DELIVERY_FEE_GBP=4.95
APPOINTMENT_DEPOSIT_PERCENTAGE=25

# Transactional email
# Keep EMAIL_VERIFICATION_REQUIRED=false until live SMTP credentials have been
# installed and verified. Once both real SMTP and email delivery are active, set
# EMAIL_VERIFICATION_REQUIRED=true to require activation before first sign-in.
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER_MODE=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_REJECT_UNAUTHORIZED=true
SMTP_USER=info@francescopicardi.co.uk
SMTP_PASSWORD=
EMAIL_FROM_NAME=SalonAI
EMAIL_FROM_ADDRESS=info@francescopicardi.co.uk
EMAIL_FROM=info@francescopicardi.co.uk
EMAIL_REPLY_TO=info@francescopicardi.co.uk
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000

# Transactional messaging
#
# WhatsApp is provider-independent.
# Choose: console, meta or twilio.
# Keep delivery disabled until the selected provider has been configured
# and verified.
WHATSAPP_PROVIDER=console
WHATSAPP_DELIVERY_ENABLED=false

# Legacy pre-Phase 8.11A compatibility only.
# New deployments should use WHATSAPP_PROVIDER instead.
WHATSAPP_PROVIDER_MODE=

SMS_PROVIDER_MODE=mock

MESSAGE_DELIVERY_MODE=mock
MESSAGE_CONSENT_REQUIRED=true
MESSAGE_EXCLUDE_UNSUBSCRIBED=true
MESSAGE_DELIVERY_MAX_ATTEMPTS=3
MESSAGE_DELIVERY_RETRY_DELAY_MS=300000
EMAIL_DELIVERY_BATCH_SIZE=25
SMS_DELIVERY_BATCH_SIZE=25

MESSAGE_DELIVERY_SCHEDULER_ENABLED=false
MESSAGE_DELIVERY_SCHEDULER_INTERVAL_MS=60000
MESSAGE_DELIVERY_SCHEDULER_RUN_IMMEDIATELY=false
MESSAGE_DELIVERY_SCHEDULER_UNREF_TIMER=true
CAMPAIGN_SCHEDULER_LIMIT=25
CAMPAIGN_SCHEDULER_CONCURRENCY=3
MESSAGE_DELIVERY_RETRY_PROCESSING_LIMIT=50
MESSAGE_DELIVERY_RETRY_CONCURRENCY=5

# Appointment reminders use each customer's preferred reminder/communication channel.
# WhatsApp reminders use the approved Content SID below when outside the service window.
APPOINTMENT_REMINDER_JOB_ENABLED=false
APPOINTMENT_REMINDER_JOB_INTERVAL_MS=300000
APPOINTMENT_REMINDER_HOURS_BEFORE=24
APPOINTMENT_REMINDER_LOOK_AHEAD_HOURS=48
APPOINTMENT_REMINDER_JOB_RUN_IMMEDIATELY=false
APPOINTMENT_REMINDER_JOB_UNREF_TIMER=true

SCHEDULED_COMMUNICATION_JOB_ENABLED=false
SCHEDULED_COMMUNICATION_JOB_INTERVAL_MS=60000
SCHEDULED_COMMUNICATION_JOB_BATCH_SIZE=25
SCHEDULED_COMMUNICATION_JOB_RUN_IMMEDIATELY=false
SCHEDULED_COMMUNICATION_JOB_UNREF_TIMER=true

# ============================================================
# WhatsApp - Meta Cloud API
# ============================================================
#
# Used only when:
# WHATSAPP_PROVIDER=meta
# WHATSAPP_DELIVERY_ENABLED=true
#
# Do not commit real credentials.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_GRAPH_VERSION=
META_WHATSAPP_DEFAULT_TEMPLATE_LANGUAGE=en_GB
WHATSAPP_WEBHOOK_URL=

# Meta WhatsApp approved message templates.
#
# Template names must match templates approved in the
# Meta WhatsApp Business account.
#
# Leave an event-specific TEMPLATE_LANGUAGE empty to use
# META_WHATSAPP_DEFAULT_TEMPLATE_LANGUAGE.

META_WHATSAPP_ORDER_PAID_TEMPLATE_NAME=
META_WHATSAPP_ORDER_PAID_TEMPLATE_LANGUAGE=

META_WHATSAPP_REFUND_TEMPLATE_NAME=
META_WHATSAPP_REFUND_TEMPLATE_LANGUAGE=

META_WHATSAPP_APPOINTMENT_CONFIRMED_TEMPLATE_NAME=
META_WHATSAPP_APPOINTMENT_CONFIRMED_TEMPLATE_LANGUAGE=

META_WHATSAPP_APPOINTMENT_RESCHEDULED_TEMPLATE_NAME=
META_WHATSAPP_APPOINTMENT_RESCHEDULED_TEMPLATE_LANGUAGE=

META_WHATSAPP_APPOINTMENT_CANCELLED_TEMPLATE_NAME=
META_WHATSAPP_APPOINTMENT_CANCELLED_TEMPLATE_LANGUAGE=

META_WHATSAPP_APPOINTMENT_REMINDER_TEMPLATE_NAME=
META_WHATSAPP_APPOINTMENT_REMINDER_TEMPLATE_LANGUAGE=

META_WHATSAPP_APPOINTMENT_PAYMENT_REQUEST_TEMPLATE_NAME=
META_WHATSAPP_APPOINTMENT_PAYMENT_REQUEST_TEMPLATE_LANGUAGE=

META_WHATSAPP_APPOINTMENT_PAYMENT_FAILED_TEMPLATE_NAME=
META_WHATSAPP_APPOINTMENT_PAYMENT_FAILED_TEMPLATE_LANGUAGE=

META_WHATSAPP_APPOINTMENT_PAYMENT_RECEIVED_TEMPLATE_NAME=
META_WHATSAPP_APPOINTMENT_PAYMENT_RECEIVED_TEMPLATE_LANGUAGE=

# ============================================================
# Twilio - SMS and optional WhatsApp provider
# ============================================================
#
# Twilio may be used for SMS while Meta is independently used
# for WhatsApp.
#
# Example:
# SMS_PROVIDER=twilio
# WHATSAPP_PROVIDER=meta
#
# TWILIO_WHATSAPP_FROM and WhatsApp Content SIDs are required
# only when WHATSAPP_PROVIDER=twilio.

SMS_DELIVERY_ENABLED=false
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=
DEFAULT_PHONE_COUNTRY_CODE=GB
TWILIO_STATUS_CALLBACK_URL=
TWILIO_WHATSAPP_STATUS_CALLBACK_URL=
TWILIO_WEBHOOK_VALIDATION_ENABLED=true
TWILIO_WEBHOOK_BASE_URL=

TWILIO_WHATSAPP_ORDER_PAID_CONTENT_SID=
TWILIO_WHATSAPP_REFUND_CONTENT_SID=
TWILIO_WHATSAPP_APPOINTMENT_CONFIRMED_CONTENT_SID=
TWILIO_WHATSAPP_APPOINTMENT_RESCHEDULED_CONTENT_SID=
TWILIO_WHATSAPP_APPOINTMENT_CANCELLED_CONTENT_SID=
TWILIO_WHATSAPP_APPOINTMENT_REMINDER_CONTENT_SID=
TWILIO_WHATSAPP_APPOINTMENT_PAYMENT_REQUEST_CONTENT_SID=
TWILIO_WHATSAPP_APPOINTMENT_PAYMENT_FAILED_CONTENT_SID=
TWILIO_WHATSAPP_APPOINTMENT_PAYMENT_RECEIVED_CONTENT_SID=

METRICS_ENABLED=true
TRACING_ENABLED=true
TRACE_EXPORT_TIMEOUT_MS=5000
OTEL_TRACES_SAMPLER_ARG=0.1
