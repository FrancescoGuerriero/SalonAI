# SalonAI backend environment example
# Copy to .env for local development or .env.production for production.
# Never commit populated secret files.

NODE_ENV=development
HOST=0.0.0.0
PORT=5000
APPLICATION_NAME=SalonAI
FRONTEND_URL=http://localhost:5173
APPLICATION_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000/api
BOOKING_URL=http://localhost:5173/booking
SERVER_SHUTDOWN_TIMEOUT_MS=30000
LOG_LEVEL=info

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=<generate-at-least-64-random-bytes>
JWT_REFRESH_SECRET=<generate-a-different-at-least-64-random-bytes>
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PASSWORD_RESET_MINUTES=20

SALON_NAME=SalonAI Demo Salon
SALON_EMAIL=hello@example.com
SALON_PHONE=+440000000000
SALON_ADDRESS=London, UK

AI_SERVICE_URL=http://localhost:8000
AI_PROVIDER_MODE=mock
AI_PROVIDER=mock
AI_ENDPOINT=
AI_MODEL=
AI_API_KEY=

# Keep console for normal local work. Change to stripe only after adding test credentials.
PAYMENT_PROVIDER_MODE=console
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DELIVERY_FEE_GBP=4.95

EMAIL_PROVIDER_MODE=mock
WHATSAPP_PROVIDER_MODE=mock
SMS_PROVIDER_MODE=mock
MESSAGE_DELIVERY_MODE=mock
MESSAGE_CONSENT_REQUIRED=true
MESSAGE_EXCLUDE_UNSUBSCRIBED=true
MESSAGE_DELIVERY_MAX_ATTEMPTS=3
MESSAGE_DELIVERY_RETRY_DELAY_MS=300000
EMAIL_DELIVERY_BATCH_SIZE=25
SMS_DELIVERY_BATCH_SIZE=25

MESSAGE_DELIVERY_SCHEDULER_ENABLED=false
MESSAGE_DELIVERY_SCHEDULER_INTERVAL_MS=60000
MESSAGE_DELIVERY_SCHEDULER_RUN_IMMEDIATELY=false
MESSAGE_DELIVERY_SCHEDULER_UNREF_TIMER=true
CAMPAIGN_SCHEDULER_LIMIT=25
CAMPAIGN_SCHEDULER_CONCURRENCY=3
MESSAGE_DELIVERY_RETRY_PROCESSING_LIMIT=50
MESSAGE_DELIVERY_RETRY_CONCURRENCY=5

APPOINTMENT_REMINDER_JOB_ENABLED=false
APPOINTMENT_REMINDER_JOB_INTERVAL_MS=300000
APPOINTMENT_REMINDER_HOURS_BEFORE=24
APPOINTMENT_REMINDER_LOOK_AHEAD_HOURS=48
APPOINTMENT_REMINDER_CHANNEL=email
APPOINTMENT_REMINDER_JOB_RUN_IMMEDIATELY=false
APPOINTMENT_REMINDER_JOB_UNREF_TIMER=true

SCHEDULED_COMMUNICATION_JOB_ENABLED=false
SCHEDULED_COMMUNICATION_JOB_INTERVAL_MS=60000
SCHEDULED_COMMUNICATION_JOB_BATCH_SIZE=25
SCHEDULED_COMMUNICATION_JOB_RUN_IMMEDIATELY=false
SCHEDULED_COMMUNICATION_JOB_UNREF_TIMER=true

# Password reset email delivery. In development, disabled mode returns a local reset link.
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=SalonAI
EMAIL_FROM_ADDRESS=
EMAIL_FROM=
EMAIL_REPLY_TO=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000

# Twilio / WhatsApp. Set WHATSAPP_PROVIDER_MODE=twilio when credentials are configured.
SMS_DELIVERY_ENABLED=false
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=
DEFAULT_PHONE_COUNTRY_CODE=GB
TWILIO_STATUS_CALLBACK_URL=
TWILIO_WEBHOOK_VALIDATION_ENABLED=true
TWILIO_WEBHOOK_BASE_URL=

METRICS_ENABLED=true
TRACING_ENABLED=true
TRACE_EXPORT_TIMEOUT_MS=5000
OTEL_TRACES_SAMPLER_ARG=0.1
