# SalonAI backend environment example
# Copy to .env for local development or .env.production for production.
# Never commit populated secret files.

NODE_ENV=development
HOST=0.0.0.0
PORT=5000
APPLICATION_NAME=SalonAI
FRONTEND_URL=http://localhost:5173
APPLICATION_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000/api
BOOKING_URL=http://localhost:5173/booking
SERVER_SHUTDOWN_TIMEOUT_MS=30000
LOG_LEVEL=info

MONGODB_URI=
JWT_SECRET=<generate-at-least-64-random-bytes>
JWT_REFRESH_SECRET=<generate-a-different-at-least-64-random-bytes>
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PASSWORD_RESET_MINUTES=20

# Production is behind the trusted SalonAI nginx edge container.
TRUST_PROXY=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30

SALON_NAME=SalonAI
SALON_EMAIL=info@francescopicardi.co.uk
SALON_PHONE=+440000000000
SALON_ADDRESS=London, UK
SALON_TIME_ZONE=Europe/London

# AI Intelligent Business Platform canonical reference tenant.
# Dry-run may use code defaults, but production --apply requires all six
# SALONAI_CANONICAL_* identity values to be explicitly operator-approved.
SALONAI_CANONICAL_BUSINESS_NAME=Francesco Picardi
SALONAI_CANONICAL_BUSINESS_SLUG=francesco-picardi
SALONAI_CANONICAL_LOCATION_NAME=Primary Location
SALONAI_CANONICAL_LOCATION_SLUG=primary-location
SALONAI_CANONICAL_PRIMARY_DOMAIN=francescopicardi.co.uk
SALONAI_CANONICAL_APP_DOMAIN=salonai.francescopicardi.co.uk
SALONAI_CANONICAL_TIMEZONE=Europe/London
SALONAI_CANONICAL_LOCALE=en-GB
SALONAI_CANONICAL_CURRENCY=GBP
SERVICE_PUBLIC_TENANT_HOST_OVERRIDE=

AI_SERVICE_URL=http://localhost:8000
AI_PROVIDER_MODE=mock
AI_PROVIDER=mock
AI_ENDPOINT=
AI_MODEL=
AI_API_KEY=

PAYMENT_PROVIDER_MODE=console
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DELIVERY_FEE_GBP=4.95
APPOINTMENT_DEPOSIT_PERCENTAGE=25

