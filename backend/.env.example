# SalonAI backend environment example
# Copy to .env for local development or .env.production for production.
# Never commit populated secret files.

NODE_ENV=development
HOST=0.0.0.0
PORT=5000
APPLICATION_NAME=SalonAI
FRONTEND_URL=http://localhost:5173
APPLICATION_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000/api
BOOKING_URL=http://localhost:5173/booking
SERVER_SHUTDOWN_TIMEOUT_MS=30000
LOG_LEVEL=info

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=<generate-at-least-64-random-bytes>
JWT_REFRESH_SECRET=<generate-a-different-at-least-64-random-bytes>
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PASSWORD_RESET_MINUTES=20

# Production is behind the trusted SalonAI nginx edge container.
TRUST_PROXY=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30

SALON_NAME=SalonAI
SALON_EMAIL=info@francescopicardi.co.uk
SALON_PHONE=+440000000000
SALON_ADDRESS=London, UK
SALON_TIME_ZONE=Europe/London

AI_SERVICE_URL=http://localhost:8000
AI_PROVIDER_MODE=mock
AI_PROVIDER=mock
AI_ENDPOINT=
AI_MODEL=
AI_API_KEY=

# Stripe payments
# Local development may use console. Production payment acceptance should use stripe.
# Production refuses to start with sk_test_... when PAYMENT_PROVIDER_MODE=stripe.
PAYMENT_PROVIDER_MODE=console
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DELIVERY_FEE_GBP=4.95
APPOINTMENT_DEPOSIT_PERCENTAGE=25



# Customer social sign-in
# Identity scopes only. Calendar/mail/contact permissions are not requested here.
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
SOCIAL_GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/social/google/callback

SOCIAL_FACEBOOK_CLIENT_ID=
SOCIAL_FACEBOOK_CLIENT_SECRET=
SOCIAL_FACEBOOK_REDIRECT_URI=http://localhost:5000/api/auth/social/facebook/callback
FACEBOOK_GRAPH_VERSION=

SOCIAL_MICROSOFT_CLIENT_ID=
SOCIAL_MICROSOFT_CLIENT_SECRET=
SOCIAL_MICROSOFT_REDIRECT_URI=http://localhost:5000/api/auth/social/microsoft/callback

SOCIAL_YAHOO_CLIENT_ID=
SOCIAL_YAHOO_CLIENT_SECRET=
SOCIAL_YAHOO_REDIRECT_URI=http://localhost:5000/api/auth/social/yahoo/callback

# Optional employee external-calendar connections
# SalonAI remains the canonical appointment calendar.
# Generate a 32-byte key and store it as base64 or 64-character hex.
CALENDAR_TOKEN_ENCRYPTION_KEY=

# Optional provider push notifications for faster two-way reconciliation.
# Keep disabled until the public HTTPS callback has been acceptance-tested.
CALENDAR_WEBHOOKS_ENABLED=false
CALENDAR_WEBHOOK_BASE_URL=
CALENDAR_WEBHOOK_SECRET=

# Manual real-provider calendar acceptance. Use a dedicated test/staff calendar.
# Do not persist CALENDAR_ACCEPTANCE_CONFIRM in production configuration;
# provide it only for the one command that deliberately runs the test.
CALENDAR_ACCEPTANCE_PROVIDER=
CALENDAR_ACCEPTANCE_ACCOUNT_EMAIL=
CALENDAR_ACCEPTANCE_CONNECTION_ID=
CALENDAR_ACCEPTANCE_REQUIRE_WEBHOOK=false
CALENDAR_ACCEPTANCE_WEBHOOK_TIMEOUT_MS=30000

# Google Calendar OAuth (staff accounts only)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5000/api/calendar-oauth/google/callback

# Microsoft Outlook / Microsoft 365 OAuth (staff accounts only)
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_TENANT=common
MICROSOFT_CALENDAR_REDIRECT_URI=http://localhost:5000/api/calendar-oauth/outlook/callback


# Privacy and direct-marketing compliance foundation
# Marketing remains fail-closed until the real business identity and contact
# details below are configured. Do not use a private residential address unless
# you intend it to be publicly disclosed in marketing material.
LEGAL_BUSINESS_NAME=
LEGAL_TRADING_NAME=SalonAI
LEGAL_COMPANY_NUMBER=
LEGAL_REGISTERED_JURISDICTION=United Kingdom
LEGAL_POSTAL_ADDRESS=
PRIVACY_CONTACT_EMAIL=
PRIVACY_POLICY_VERSION=2026-09
PRIVACY_POLICY_URL=
MARKETING_PREFERENCE_URL=
# Dedicated random secret required for signed public preference links.
# Generate at least 32 random bytes and do not reuse JWT/OAuth/provider secrets.
MARKETING_PREFERENCE_TOKEN_SECRET=

# Transactional and campaign email — Twilio SendGrid
#
# SalonAI uses SendGrid through its SMTP relay so transactional email,
# scheduled communications and consent-governed email campaigns share the
# same delivery engine. Generic SMTP remains supported by setting
# EMAIL_PROVIDER=smtp and supplying the SMTP_* values explicitly.
#
# Keep EMAIL_VERIFICATION_REQUIRED=false until the real SendGrid sender/domain
# and deliberate provider acceptance test have passed. Then enable account
# verification if required.
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=

# Signed SendGrid Event Webhook.
# Keep disabled until the public HTTPS endpoint and SendGrid signing key are configured.
# Production live SendGrid delivery requires this signed callback to be enabled.
SENDGRID_EVENT_WEBHOOK_ENABLED=false
SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=

# SendGrid marketing/newsletter activation gate.
# These are operator attestations, not credentials. Keep SENDGRID_MARKETING_ENABLED=false
# until the sender identity, domain authentication, signed webhook and controlled
# marketing acceptance test have all been completed successfully.
SENDGRID_MARKETING_ENABLED=false
SENDGRID_SENDER_VERIFIED=false
SENDGRID_DOMAIN_AUTHENTICATED=false
SENDGRID_MARKETING_ACCEPTANCE_CONFIRMED=false

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=SalonAI
EMAIL_FROM_ADDRESS=info@francescopicardi.co.uk
EMAIL_FROM=info@francescopicardi.co.uk
EMAIL_REPLY_TO=info@francescopicardi.co.uk
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000

# Manual real-provider SendGrid acceptance.
# SENDGRID_ACCEPTANCE_CONFIRM is deliberately omitted; provide
# SENDGRID_ACCEPTANCE_CONFIRM=RUN_SENDGRID_EMAIL_ACCEPTANCE only for the
# deliberate one-off acceptance command.
SENDGRID_ACCEPTANCE_TO=
SENDGRID_ACCEPTANCE_SUBJECT=SalonAI SendGrid acceptance test
SENDGRID_ACCEPTANCE_MESSAGE=SalonAI Twilio SendGrid acceptance test. No reply is required.

# Controlled marketing/newsletter acceptance.
# SENDGRID_MARKETING_ACCEPTANCE_CONFIRM is deliberately omitted; provide
# SENDGRID_MARKETING_ACCEPTANCE_CONFIRM=RUN_SENDGRID_MARKETING_ACCEPTANCE
# only for the deliberate one-off test. Keep SENDGRID_MARKETING_ENABLED=false
# while running acceptance.
SENDGRID_MARKETING_ACCEPTANCE_TO=
SENDGRID_MARKETING_ACCEPTANCE_GROUP_ID=
SENDGRID_MARKETING_ACCEPTANCE_SUBJECT=SalonAI SendGrid marketing acceptance test
SENDGRID_MARKETING_ACCEPTANCE_MESSAGE=SalonAI SendGrid marketing acceptance test. This message validates the controlled suppression-group delivery path.

# Transactional messaging
#
# WhatsApp is provider-independent.
# Choose: console, meta or twilio.
# Keep delivery disabled until the selected provider has been configured
# and verified.
WHATSAPP_PROVIDER=console
WHATSAPP_DELIVERY_ENABLED=false

# Automated WhatsApp AI receptionist
# Master processing switch. Keep disabled until the orchestrator has passed
# local tests, pull-request CI and production shadow-mode verification.
WHATSAPP_BOT_ENABLED=false

# Independent customer-facing send switch. This remains false while the bot
# is analysing and maintaining state without automatically replying to users.
WHATSAPP_BOT_SEND_REPLIES=false

# Minimum accepted intent confidence before conservative human handoff.
WHATSAPP_BOT_MIN_CONFIDENCE=0.75

# Provisional booking-request lifetime in minutes.
WHATSAPP_BOT_SESSION_MINUTES=30

# Maximum service/category options to include in one automated reply.
WHATSAPP_BOT_MAX_SERVICE_OPTIONS=8

# Optional verified customer-facing opening-hours text. Leave empty rather
# than allowing the AI layer to invent business hours.
SALON_OPENING_HOURS=

# Legacy *_PROVIDER_MODE variables remain runtime-compatible for existing
# deployments but are intentionally omitted from this template.
MESSAGE_DELIVERY_MODE=sandbox
MESSAGE_CONSENT_REQUIRED=true
MESSAGE_EXCLUDE_UNSUBSCRIBED=true
MESSAGE_DELIVERY_MAX_ATTEMPTS=3
MESSAGE_DELIVERY_RETRY_DELAY_MS=300000
EMAIL_DELIVERY_BATCH_SIZE=25
SMS_DELIVERY_BATCH_SIZE=25

MESSAGE_DELIVERY_SCHEDULER_ENABLED=false
MESSAGE_DELIVERY_SCHEDULER_INTERVAL_MS=60000
MESSAGE_DELIVERY_SCHEDULER_RUN_IMMEDIATELY=false
MESSAGE_DELIVERY_SCHEDULER_UNREF_TIMER=true
CAMPAIGN_SCHEDULER_LIMIT=25
CAMPAIGN_SCHEDULER_CONCURRENCY=3
MESSAGE_DELIVERY_RETRY_PROCESSING_LIMIT=50
MESSAGE_DELIVERY_RETRY_CONCURRENCY=5

# Appointment reminders use each customer's preferred reminder/communication channel.
# WhatsApp reminders use the approved Content SID below when outside the service window.
APPOINTMENT_REMINDER_JOB_ENABLED=false
APPOINTMENT_REMINDER_JOB_INTERVAL_MS=300000
APPOINTMENT_REMINDER_HOURS_BEFORE=24
APPOINTMENT_REMINDER_LOOK_AHEAD_HOURS=48
APPOINTMENT_REMINDER_JOB_RUN_IMMEDIATELY=false
APPOINTMENT_REMINDER_JOB_UNREF_TIMER=true

SCHEDULED_COMMUNICATION_JOB_ENABLED=false
SCHEDULED_COMMUNICATION_JOB_INTERVAL_MS=60000
SCHEDULED_COMMUNICATION_JOB_BATCH_SIZE=25
SCHEDULED_COMMUNICATION_JOB_RUN_IMMEDIATELY=false
SCHEDULED_COMMUNICATION_JOB_UNREF_TIMER=true

# ============================================================
# WhatsApp - Meta Cloud API
# ============================================================
#
# Used only when:
# WHATSAPP_PROVIDER=meta
# WHATSAPP_DELIVERY_ENABLED=true
#
# Do not commit real credentials.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_GRAPH_VERSION=
META_WHATSAPP_DEFAULT_TEMPLATE_LANGUAGE=en_GB
WHATSAPP_WEBHOOK_URL=

# Meta WhatsApp approved message templates.
#
# Template names must match templates approved in the
# Meta WhatsApp Business account.
#
# Leave an event-specific TEMPLATE_LANGUAGE empty to use
# META_WHATSAPP_DEFAULT_TEMPLATE_LANGUAGE.

META_WHATSAPP_ORDER_PAID_TEMPLATE_NAME=
META_WHATSAPP_ORDER_PAID_TEMPLATE_LANGUAGE=

META_WHATSAPP_REFUND_TEMPLATE_NAME=
META_WHATSAPP_REFUND_TEMPLATE_LANGUAGE=

META_WHATSAPP_APPOINTMENT_CONFIRMED_TEMPLATE_NAME=
META_WHATSAPP_APPOINTMENT_CONFIRMED_TEMPLATE_LANGUAGE=

META_WHATSAPP_APPOINTMENT_RESCHEDULED_TEMPLATE_NAME=
META_WHATSAPP_APPOINTMENT_RESCHEDULED_TEMPLATE_LANGUAGE=

META_WHATSAPP_APPOINTMENT_CANCELLED_TEMPLATE_NAME=
META_WHATSAPP_APPOINTMENT_CANCELLED_TEMPLATE_LANGUAGE=

META_WHATSAPP_APPOINTMENT_REMINDER_TEMPLATE_NAME=
META_WHATSAPP_APPOINTMENT_REMINDER_TEMPLATE_LANGUAGE=

META_WHATSAPP_APPOINTMENT_PAYMENT_REQUEST_TEMPLATE_NAME=
META_WHATSAPP_APPOINTMENT_PAYMENT_REQUEST_TEMPLATE_LANGUAGE=

META_WHATSAPP_APPOINTMENT_PAYMENT_FAILED_TEMPLATE_NAME=
META_WHATSAPP_APPOINTMENT_PAYMENT_FAILED_TEMPLATE_LANGUAGE=

META_WHATSAPP_APPOINTMENT_PAYMENT_RECEIVED_TEMPLATE_NAME=
META_WHATSAPP_APPOINTMENT_PAYMENT_RECEIVED_TEMPLATE_LANGUAGE=

# ============================================================
# Twilio - SMS and optional WhatsApp provider
# ============================================================
#
# Twilio may be used for SMS while Meta is independently used
# for WhatsApp.
#
# Example:
# SMS_PROVIDER=twilio
# WHATSAPP_PROVIDER=meta
#
# TWILIO_WHATSAPP_FROM and WhatsApp Content SIDs are required
# only when WHATSAPP_PROVIDER=twilio.

SMS_DELIVERY_ENABLED=false
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=
DEFAULT_PHONE_COUNTRY_CODE=+44
TWILIO_STATUS_CALLBACK_URL=
TWILIO_WHATSAPP_STATUS_CALLBACK_URL=
TWILIO_WEBHOOK_VALIDATION_ENABLED=true
TWILIO_WEBHOOK_BASE_URL=

# Manual real-provider Twilio acceptance. Use dedicated test recipients.
# The required TWILIO_ACCEPTANCE_CONFIRM safety token is intentionally not
# stored in this template; provide it only for the deliberate acceptance run.
TWILIO_ACCEPTANCE_CHANNELS=sms,whatsapp
TWILIO_ACCEPTANCE_SMS_TO=
TWILIO_ACCEPTANCE_WHATSAPP_TO=
TWILIO_ACCEPTANCE_MESSAGE=SalonAI Twilio acceptance test. No reply is required.
TWILIO_ACCEPTANCE_REQUIRE_DELIVERY=false
TWILIO_ACCEPTANCE_STATUS_TIMEOUT_MS=60000
TWILIO_ACCEPTANCE_STATUS_POLL_MS=1000
TWILIO_ACCEPTANCE_WHATSAPP_CONTENT_SID=
TWILIO_ACCEPTANCE_WHATSAPP_CONTENT_VARIABLES=

TWILIO_WHATSAPP_ORDER_PAID_CONTENT_SID=
TWILIO_WHATSAPP_REFUND_CONTENT_SID=
TWILIO_WHATSAPP_APPOINTMENT_CONFIRMED_CONTENT_SID=
TWILIO_WHATSAPP_APPOINTMENT_RESCHEDULED_CONTENT_SID=
TWILIO_WHATSAPP_APPOINTMENT_CANCELLED_CONTENT_SID=
TWILIO_WHATSAPP_APPOINTMENT_REMINDER_CONTENT_SID=
TWILIO_WHATSAPP_APPOINTMENT_PAYMENT_REQUEST_CONTENT_SID=
TWILIO_WHATSAPP_APPOINTMENT_PAYMENT_FAILED_CONTENT_SID=
TWILIO_WHATSAPP_APPOINTMENT_PAYMENT_RECEIVED_CONTENT_SID=

METRICS_ENABLED=true
TRACING_ENABLED=true
TRACE_EXPORT_TIMEOUT_MS=5000
OTEL_TRACES_SAMPLER_ARG=0.1

# AI training-data pseudonymisation.
# Use a dedicated random secret (minimum 32 characters); never reuse OAuth/JWT keys.
AI_DATASET_PSEUDONYM_KEY=


# Optional staff external-calendar synchronization worker.
# Keep disabled until Google/Microsoft credentials and acceptance tests are complete.
CALENDAR_SYNC_WORKER_ENABLED=false
CALENDAR_SYNC_WORKER_INTERVAL_MS=30000
CALENDAR_SYNC_WORKER_BATCH_SIZE=25
CALENDAR_SYNC_INBOUND_INTERVAL_MS=120000
