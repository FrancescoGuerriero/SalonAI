FROM node:26-alpine AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

FROM dependencies AS build

ARG VITE_API_URL=/api
ARG VITE_AI_API_URL=/api/ai

ARG VITE_WHATSAPP_NUMBER=
ARG VITE_WHATSAPP_MESSAGE=

ARG VITE_INSTAGRAM_URL=
ARG VITE_FACEBOOK_URL=
ARG VITE_TIKTOK_URL=
ARG VITE_YOUTUBE_URL=

ARG VITE_APP_STORE_URL=
ARG VITE_GOOGLE_PLAY_URL=

ARG VITE_NONESSENTIAL_TRACKING_ENABLED=false
ARG VITE_TRACKING_CONSENT_VERSION=2026-09-23
ARG VITE_TRACKING_CONSENT_TTL_DAYS=180
ARG VITE_GOOGLE_ANALYTICS_ID=
ARG VITE_GOOGLE_ADS_ID=
ARG VITE_META_PIXEL_ID=
ARG VITE_HOTJAR_SITE_ID=
ARG VITE_MICROSOFT_ADS_UET_TAG_ID=
ARG VITE_GOOGLE_SITE_VERIFICATION=
ARG VITE_BING_SITE_VERIFICATION=

ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_AI_API_URL=${VITE_AI_API_URL}

ENV VITE_WHATSAPP_NUMBER=${VITE_WHATSAPP_NUMBER}
ENV VITE_WHATSAPP_MESSAGE=${VITE_WHATSAPP_MESSAGE}

ENV VITE_INSTAGRAM_URL=${VITE_INSTAGRAM_URL}
ENV VITE_FACEBOOK_URL=${VITE_FACEBOOK_URL}
ENV VITE_TIKTOK_URL=${VITE_TIKTOK_URL}
ENV VITE_YOUTUBE_URL=${VITE_YOUTUBE_URL}

ENV VITE_APP_STORE_URL=${VITE_APP_STORE_URL}
ENV VITE_GOOGLE_PLAY_URL=${VITE_GOOGLE_PLAY_URL}

ENV VITE_NONESSENTIAL_TRACKING_ENABLED=${VITE_NONESSENTIAL_TRACKING_ENABLED}
ENV VITE_TRACKING_CONSENT_VERSION=${VITE_TRACKING_CONSENT_VERSION}
ENV VITE_TRACKING_CONSENT_TTL_DAYS=${VITE_TRACKING_CONSENT_TTL_DAYS}
ENV VITE_GOOGLE_ANALYTICS_ID=${VITE_GOOGLE_ANALYTICS_ID}
ENV VITE_GOOGLE_ADS_ID=${VITE_GOOGLE_ADS_ID}
ENV VITE_META_PIXEL_ID=${VITE_META_PIXEL_ID}
ENV VITE_HOTJAR_SITE_ID=${VITE_HOTJAR_SITE_ID}
ENV VITE_MICROSOFT_ADS_UET_TAG_ID=${VITE_MICROSOFT_ADS_UET_TAG_ID}
ENV VITE_GOOGLE_SITE_VERIFICATION=${VITE_GOOGLE_SITE_VERIFICATION}
ENV VITE_BING_SITE_VERIFICATION=${VITE_BING_SITE_VERIFICATION}

COPY . .

RUN npm run build

FROM nginxinc/nginx-unprivileged:1.31.6-alpine3.24 AS runtime

# SALONAI_PHASE_7_11_FRONTEND_RUNTIME_HARDENING=3

USER 0

RUN apk upgrade --no-cache

USER 101

COPY --chown=101:101 nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build --chown=101:101 /app/dist /usr/share/nginx/html